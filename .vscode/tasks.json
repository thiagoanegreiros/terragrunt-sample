{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project setup",
      "type": "shell",
      "command": "./.vscode/project-setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "./.vscode/run-tofu-test.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "group": "test"
    }
  ]
}
